# Prompt2Music on Vercel Fluid Compute.
# Vercel auto-detects Dockerfile.vercel and deploys it as a container-backed Function.

ARG PORT=80

FROM python:3.13-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /bin/uv
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun
ENV UV_COMPILE_BYTECODE=1 UV_NO_CACHE=1 PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY requirements.txt .
RUN uv venv && uv pip install -r requirements.txt

COPY . .

# Build the static Reflex frontend during the image build. Keeping api_url at
# its localhost default lets Reflex substitute the public Vercel hostname when
# the page is served over HTTPS from the same origin as the backend.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    reflex export --frontend-only --no-zip

FROM python:3.13-slim

COPY --from=caddy:2 /usr/bin/caddy /usr/bin/caddy

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    GRANIAN_WORKERS=1 \
    REFLEX_TELEMETRY_ENABLED=false

WORKDIR /app
RUN adduser --disabled-password --gecos "" --home /app reflex && chown reflex /app

COPY --chown=reflex --from=builder /app/.venv .venv
COPY --chown=reflex --from=builder /app/.web/backend .web/backend
COPY --from=builder /app/.web/build/client /srv
COPY --chown=reflex . .

USER reflex

# Vercel injects PORT at runtime (80 by default for container deployments).
CMD sh -c 'cat > /tmp/Caddyfile <<EOF\n:${PORT}\nencode gzip\n@backend_routes path /_event/* /ping /_health /_upload /_upload/*\nhandle @backend_routes {\n    reverse_proxy localhost:8000\n}\nroot * /srv\nroute {\n    try_files {path} {path}/ /404.html\n    file_server {\n        precompressed br zstd gzip\n    }\n}\nEOF\ncaddy start --config /tmp/Caddyfile && exec reflex run --env prod --backend-only --backend-port 8000'
